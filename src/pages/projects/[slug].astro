---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, img, year, CATEGORIES, type Project } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: {
      project: p,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const category = CATEGORIES[data.category];
const dateLabel = data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const lightbox = data.photos.map((ph, i) => ({
  full: img(ph.image, 2000),
  alt: ph.alt || data.title,
  title: data.title,
  sub: [category, data.location, year(data.date)].filter(Boolean).join(' · '),
}));
---

<Base title={data.title} description={`${data.title}: ${category.toLowerCase()} photography by Gilbert Arevalo${data.location ? `, ${data.location}` : ''}.`} image={data.cover}>
  <main class="page">
    <a href={`/projects?category=${data.category}`} class="back eyebrow link">← {category}</a>

    <header class="head">
      <h1 class="display">{data.title}</h1>
      <dl class="meta">
        <div><dt>Category</dt><dd>{category}</dd></div>
        {data.location && <div><dt>Location</dt><dd>{data.location}</dd></div>}
        <div><dt>Date</dt><dd>{dateLabel}</dd></div>
        {data.client && <div><dt>Client</dt><dd>{data.client}</dd></div>}
        <div><dt>Frames</dt><dd>{data.photos.length}</dd></div>
      </dl>
    </header>

    <div class="story"><Content /></div>

    <ul class="gallery">
      {
        data.photos.map((ph, i) => (
          <li>
            <button type="button" class="shot bw-host" data-lb={i} data-cursor="View" aria-label={`Open photo ${i + 1}`}>
              <img class="bw" src={img(ph.image, 1100)} alt={ph.alt || data.title} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </button>
          </li>
        ))
      }
    </ul>

    <nav class="pager" aria-label="More projects">
      <a href={`/projects/${prev.id}`} class="pager-link">
        <span class="eyebrow">← Previous</span>
        <span class="display">{prev.data.title}</span>
      </a>
      <a href={`/projects/${next.id}`} class="pager-link right">
        <span class="eyebrow">Next →</span>
        <span class="display">{next.data.title}</span>
      </a>
    </nav>
  </main>

  <script type="application/json" id="lightbox-data" set:html={JSON.stringify(lightbox)} />
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 24px;
  }
  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: end;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .head h1 {
    font-size: clamp(52px, 9vw, 128px);
    margin: 0;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 12px 40px;
    margin: 0;
    font-size: 13px;
  }
  .meta dt {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
  }
  .story {
    max-width: 560px;
    margin: 32px 0 56px;
    font-size: 17px;
    color: var(--muted);
  }
  .story :global(p) {
    margin: 0 0 1em;
  }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 300px;
    column-gap: 28px;
  }
  .gallery li {
    break-inside: avoid;
    margin-bottom: 28px;
  }
  .shot {
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  .shot img {
    width: 100%;
    height: auto;
  }
  .shot:hover img {
    transform: scale(1.025);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pager-link .display {
    font-size: clamp(26px, 4vw, 48px);
    transition: color 0.3s;
  }
  .pager-link:hover .display {
    color: var(--accent);
  }
  .pager-link.right {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 760px) {
    .head {
      grid-template-columns: 1fr;
    }
  }
</style>
